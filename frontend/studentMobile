## 10. 資料型別定義 (TypeScript)

```typescript
// 錯題記錄
interface Mistake {
  id: string;
  questionText: string;
  studentQuestion: string;
  correctAnswer: string;
  aiSummary: string;
  fullExplanation: string;
  conceptId: string;
  unitId: string;
  subUnitId: string | null;
  mistakeCount: number;
  starred: boolean;
  starredAt: string | null;
  createdAt: string;
}

// 概念
interface Concept {
  id: string;
  name: string;
  unitId: string;
  subjectId: string;
  mistakeCount: number;
  keywords: string[];
}

// 聊天訊息
interface ChatMessage {
  id: string;
  sessionId: string;
  role: 'student' | 'assistant';
  content: string;
  messageType: 'new_question' | 'follow_up' | 'answer' | 'request_practice';
  createdAt: string;
}

// API 回應
interface ApiResponse<T> {
  success: boolean;
  data: T;
  message: string | null;
  code?: string;
}
